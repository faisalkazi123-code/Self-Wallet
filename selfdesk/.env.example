# Your domain, e.g. desk.mycompany.com (its DNS A record must point to this server)
SELFDESK_DOMAIN=desk.example.com
# Generate each with:  python3 -c "import secrets;print(secrets.token_urlsafe(24))"
# Given to every PC agent when you install it:
SELFDESK_ENROLL_TOKEN=change-me-enroll-token
# Typed in the browser to see/control PCs:
SELFDESK_ACCESS_KEY=change-me-access-key
